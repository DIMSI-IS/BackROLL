BACKROLL_DB=$backroll_db
BACKROLL_MODE=$backroll_mode
DB_ADDRESS=$db_address
DB_BASE=$db_name
DB_PORT=$db_port
DB_USER_NAME=$db_user_name
DB_USER_PASSWORD=$db_user_password
FLOWER_PASSWORD=$flower_password
FLOWER_USER=$flower_user
FRONT_URL=$front_url
JWT_SECRET=$jwt_secret
# Key that encrypts the secrets kept in the database (the password of the Active Directory account,
# the secret key of the CloudStack connectors, the address of the Slack webhooks).
# Keep this file with the backups of the database: without this key the secrets can not be read and are typed again.
SECRETS_KEY=$secrets_key
MARIADB_DATABASE=$db_name
MARIADB_PASSWORD=$db_user_password
MARIADB_ROOT_PASSWORD=$db_root_password
MARIADB_USER=$db_user_name
